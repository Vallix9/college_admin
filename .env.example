# Скопируйте этот файл в .env и заполните значения под своё окружение.
# Файл .env в систему контроля версий не попадает (см. .gitignore).

# Обязательно задайте свой ключ. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Требования: не короче 32 символов и не равен dev-secret-key-123 из
# config.py — подпись чужим ключом позволяет подделать сессию администратора.
# При APP_ENV=production (или WAITRESS=1) без корректного SECRET_KEY
# приложение не запустится вовсе — это намеренно.
SECRET_KEY=change-me-to-32-random-characters

# Учётная запись администратора, создаётся скриптом init_db.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# База данных. По умолчанию SQLite в корне проекта.
#   sqlite:///college.db
# Для Docker: sqlite:////app/data/college.db
DATABASE_URL=

# Сетевые настройки
HOST=127.0.0.1
PORT=5000

# Режим отладки. Только для разработки, в Docker и на сервере выключить:
# отладочная консоль Werkzeug выполняет произвольный код по PIN-коду.
FLASK_DEBUG=1

# development (по умолчанию) или production. В production действуют запреты
# на запасной SECRET_KEY и на отладку в сети.
APP_ENV=development

# Силой поднять отладочный сервер Werkzeug при FLASK_DEBUG=0 — удобно для
# перезагрузки кода без перезапуска. В production запрещён.
FLASK_DEV_SERVER=0
